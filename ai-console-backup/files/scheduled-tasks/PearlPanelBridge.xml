<?xml version="1.0" encoding="UTF-16"?>
<Task version="1.3" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>AI console: start Pearl mining / restore AI GPU settings without a UAC prompt (Pearl-mining\panel_task.py)</Description>
    <URI>\PearlPanelBridge</URI>
  </RegistrationInfo>
  <Principals>
    <Principal id="Author">
      <UserId>&lt;YOUR-USER-SID&gt;</UserId>
      <LogonType>InteractiveToken</LogonType>
      <RunLevel>HighestAvailable</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <ExecutionTimeLimit>PT0S</ExecutionTimeLimit>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <IdleSettings>
      <Duration>PT10M</Duration>
      <WaitTimeout>PT1H</WaitTimeout>
      <StopOnIdleEnd>true</StopOnIdleEnd>
      <RestartOnIdle>false</RestartOnIdle>
    </IdleSettings>
    <UseUnifiedSchedulingEngine>true</UseUnifiedSchedulingEngine>
  </Settings>
  <Triggers />
  <Actions Context="Author">
    <Exec>
      <Command>powershell.exe</Command>
      <Arguments>-NoProfile -NonInteractive -WindowStyle Hidden -Command "&amp; 'C:\Users\pjunm\AppData\Local\Programs\Python\Python311\python.exe' 'C:\Users\pjunm\Pearl-mining\panel_task.py'"</Arguments>
      <WorkingDirectory>C:\Users\pjunm\Pearl-mining</WorkingDirectory>
    </Exec>
  </Actions>
</Task>